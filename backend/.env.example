SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
BACKEND_PORT=3100

# Database
DATABASE_URL=postgresql://postgres:PASSWORD@db.XXXX.supabase.co:5432/postgres

# Redis
REDIS_URL=rediss://default:PASSWORD@XXXX.upstash.io:6379

# Notifications — Email (Gmail SMTP)
# 1. Enable 2-Step Verification on the Gmail account.
# 2. Generate a 16-char App Password at
#    https://myaccount.google.com/apppasswords
# 3. Paste it below (NOT the real account password — that won't work).
# The From header is set to "FinMate <GMAIL_USER>".
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Comma-separated allowlist for recipient domains. Default 'gmail.com'
# until our sender reputation is established with non-Gmail providers.
EMAIL_ALLOWED_DOMAINS=gmail.com

# Notifications — Other channels (not yet wired)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
SLACK_BOT_TOKEN=

# Gemini — used by alerts.summarizer to write plain-English alert prose.
# Falls back to a hardcoded template if missing or rate-limited.
GEMINI_API_KEY=

# AI / Data
OPENAI_API_KEY=
NEWSAPI_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ML Services
ML_SERVICE_URL=http://localhost:8001

# MLflow experiment tracking (DagsHub). Leave unset to disable — ML
# scripts will then run without writing to a tracking server.
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
